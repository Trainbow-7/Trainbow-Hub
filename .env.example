# ==============================================================================
# Trainbow HUB Environment Configuration
# All sensitive production credentials must be supplied via secure vault/secrets.
# Sandbox/test keys are used by default for local development.
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL 16 with btree_gist)
DATABASE_URL=postgresql://trainbow_user:trainbow_secure_password_2026@localhost:5432/trainbow_hub_dev?schema=public

# Authentication & Session Security
SESSION_SECRET=trainbow_dev_session_secret_32_chars_long_minimum_key!
SESSION_MAX_AGE_SECONDS=604800
ADMIN_MFA_ENFORCED=true

# Regional & Currency Settings
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos

# ------------------------------------------------------------------------------
# Provider Adapters (Clean TypeScript Interfaces with Sandbox Default)
# ------------------------------------------------------------------------------

# 1. Payment Provider (Default: sandbox / paystack)
PAYMENT_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=sk_test_paystack_mock_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_paystack_mock_public_key
PAYSTACK_WEBHOOK_SECRET=whsec_mock_paystack_secret_key

# 2. AI Provider (Default: sandbox / gemini / openai)
AI_PROVIDER=sandbox
AI_API_KEY=mock_sandbox_ai_api_key
AI_DAILY_STUDENT_QUOTA=25
AI_LATENCY_LOGGING_ENABLED=true

# 3. Video Provider (Default: sandbox / daily / agora)
VIDEO_PROVIDER=sandbox
DAILY_API_KEY=mock_sandbox_daily_api_key
DAILY_DOMAIN=https://trainbow-sandbox.daily.co

# 4. Messaging Provider (Default: sandbox / termii / resend)
MESSAGING_PROVIDER=sandbox
TERMII_API_KEY=mock_sandbox_termii_api_key
TERMII_SENDER_ID=Trainbow
RESEND_API_KEY=re_mock_sandbox_resend_api_key
EMAIL_FROM="Trainbow HUB <no-reply@trainbowhub.ng>"
