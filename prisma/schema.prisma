// ==============================================================================
// Trainbow HUB - Database Schema (PostgreSQL 16)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum GuardianshipStatus {
  PENDING_OTP
  VERIFIED
  REVOKED
}

enum TutorStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phoneNumber  String?   @map("phone_number")
  role         UserRole  @default(STUDENT)
  dateOfBirth  DateTime? @map("date_of_birth")
  isMinor      Boolean   @default(false) @map("is_minor")
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relationships
  tutorProfile     TutorProfile?
  studentGuardians Guardianship[]    @relation("StudentGuardianship")
  guardianStudents Guardianship[]    @relation("GuardianGuardianship")
  sessions         Session[]
  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  studyStats       StudyStats?
  authoredCourses  AuthoringCourse[]

  @@map("users")
}

model Guardianship {
  id             String             @id @default(uuid())
  studentId      String             @map("student_id")
  guardianId     String             @map("guardian_id")
  relationship   String             @default("Legal Guardian")
  status         GuardianshipStatus @default(PENDING_OTP)
  guardianPhone  String?            @map("guardian_phone")
  guardianEmail  String?            @map("guardian_email")
  otpHash        String?            @map("otp_hash")
  otpExpiresAt   DateTime?          @map("otp_expires_at")
  otpAttempts    Int                @default(0) @map("otp_attempts")
  consentGivenAt DateTime?          @map("consent_given_at")
  consentAuditLog String?           @map("consent_audit_log") // JSON audit string under NDPA 2023
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  student  User @relation("StudentGuardianship", fields: [studentId], references: [id], onDelete: Cascade)
  guardian User @relation("GuardianGuardianship", fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("guardianships")
}

model TutorProfile {
  id                   String      @id @default(uuid())
  userId               String      @unique @map("user_id")
  slug                 String      @unique
  title                String
  bio                  String
  teachingApproach     String      @map("teaching_approach")
  hourlyRateMinorUnits Int         @map("hourly_rate_minor_units") // in Kobo (e.g. 750000 = ₦7,500)
  currency             String      @default("NGN")
  rating               Float       @default(5.0)
  completedLessons     Int         @default(0) @map("completed_lessons")
  ninVerified          Boolean     @default(false) @map("nin_verified")
  backgroundChecked    Boolean     @default(false) @map("background_checked")
  trcnCertified        Boolean     @default(false) @map("trcn_certified")
  status               TutorStatus @default(PENDING_REVIEW)
  settlementBankName   String?     @map("settlement_bank_name")
  settlementAccount    String?     @map("settlement_account")
  settlementName       String?     @map("settlement_name")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_profiles")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Enrollment {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  courseSlug           String   @map("course_slug")
  completedLessonIds   String[] @map("completed_lesson_ids")
  lastAccessedLessonId String   @default("") @map("last_accessed_lesson_id")
  progressPercentage   Float    @default(0.0) @map("progress_percentage")
  enrolledAt           DateTime @default(now()) @map("enrolled_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
  @@map("enrollments")
}

model QuizAttempt {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  courseSlug          String   @map("course_slug")
  lessonId            String   @map("lesson_id")
  score               Float
  totalQuestions      Int      @map("total_questions")
  correctCount        Int      @map("correct_count")
  answersJson         String   @map("answers_json")
  recommendationsJson String   @map("recommendations_json")
  completedAt         DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model StudyStats {
  userId              String   @id @map("user_id")
  streakDays          Int      @default(1) @map("streak_days")
  lastActiveDate      DateTime @default(now()) @map("last_active_date")
  totalMinutesStudied Int      @default(0) @map("total_minutes_studied")
  lessonsCompleted    Int      @default(0) @map("lessons_completed")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_stats")
}

model AuthoringCourse {
  id               String       @id @default(uuid())
  authorId         String       @map("author_id")
  title            String
  slug             String       @unique
  subjectSlug      String       @map("subject_slug")
  level            String
  status           CourseStatus @default(DRAFT)
  version          Int          @default(1)
  changelog        String?
  priceMinorUnits  Int          @default(0) @map("price_minor_units")
  shortDescription String       @map("short_description")
  fullDescription  String       @map("full_description")
  syllabusJson     String       @map("syllabus_json")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("authoring_courses")
}
