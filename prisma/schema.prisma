// ==============================================================================
// Trainbow HUB - Database Schema (PostgreSQL 16)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum GuardianshipStatus {
  PENDING_OTP
  VERIFIED
  REVOKED
}

enum TutorStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum BookingStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  DISPUTED
}

enum PaymentStatus {
  INITIATED
  VERIFIED
  FAILED
  ABANDONED
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUNDED
}

enum LedgerEntryType {
  BOOKING_CREDIT
  COMMISSION_DEBIT
  REFUND_DEBIT
  PAYOUT
}

enum AIRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIHintLevel {
  HINT_1
  HINT_2
  HINT_3
  FULL_SOLUTION
}

enum AIFeedbackRating {
  HELPFUL
  NOT_HELPFUL
  REPORTED_ERROR
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phoneNumber  String?   @map("phone_number")
  role         UserRole  @default(STUDENT)
  dateOfBirth  DateTime? @map("date_of_birth")
  isMinor      Boolean   @default(false) @map("is_minor")
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relationships
  tutorProfile        TutorProfile?
  studentGuardians    Guardianship[]       @relation("StudentGuardianship")
  guardianStudents    Guardianship[]       @relation("GuardianGuardianship")
  sessions            Session[]
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  studyStats          StudyStats?
  authoredCourses     AuthoringCourse[]
  slotHolds           SlotHold[]
  bookingsAsStudent   Booking[]
  paymentTransactions PaymentTransaction[]
  aiConversations     AIConversation[]
  aiQuota             AIQuota?
  aiFeedbacks         AIFeedback[]
  aiEscalations       AITutorEscalation[]
  classroomAttendances ClassroomAttendance[]
  reportedIncidents   SafeguardingIncident[] @relation("ReportedIncidents")
  tutorReviews        TutorReview[]
  adminAuditLogs      AdminAuditLog[]
  tutorPayouts        TutorPayout[]
  subjectEvaluations  SubjectAIEvaluation[]
  verifiedQualifications TutorSubjectQualification[] @relation("VerifiedQualifications")
  contentSubjectAssignments ContentManagerSubjectAssignment[]

  @@map("users")
}

model Guardianship {
  id             String             @id @default(uuid())
  studentId      String             @map("student_id")
  guardianId     String             @map("guardian_id")
  relationship   String             @default("Legal Guardian")
  status         GuardianshipStatus @default(PENDING_OTP)
  guardianPhone  String?            @map("guardian_phone")
  guardianEmail  String?            @map("guardian_email")
  otpHash        String?            @map("otp_hash")
  otpExpiresAt   DateTime?          @map("otp_expires_at")
  otpAttempts    Int                @default(0) @map("otp_attempts")
  consentGivenAt DateTime?          @map("consent_given_at")
  consentAuditLog String?           @map("consent_audit_log") // JSON audit string under NDPA 2023
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  student  User @relation("StudentGuardianship", fields: [studentId], references: [id], onDelete: Cascade)
  guardian User @relation("GuardianGuardianship", fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("guardianships")
}

model TutorProfile {
  id                   String      @id @default(uuid())
  userId               String      @unique @map("user_id")
  slug                 String      @unique
  title                String
  bio                  String
  teachingApproach     String      @map("teaching_approach")
  hourlyRateMinorUnits Int         @map("hourly_rate_minor_units") // in Kobo (e.g. 750000 = ₦7,500)
  currency             String      @default("NGN")
  rating               Float       @default(5.0)
  completedLessons     Int         @default(0) @map("completed_lessons")
  ninVerified          Boolean     @default(false) @map("nin_verified")
  backgroundChecked    Boolean     @default(false) @map("background_checked")
  trcnCertified        Boolean     @default(false) @map("trcn_certified")
  status               TutorStatus @default(PENDING_REVIEW)
  settlementBankName   String?     @map("settlement_bank_name")
  settlementAccount    String?     @map("settlement_account")
  settlementName       String?     @map("settlement_name")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_profiles")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Enrollment {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  courseSlug           String   @map("course_slug")
  completedLessonIds   String[] @map("completed_lesson_ids")
  lastAccessedLessonId String   @default("") @map("last_accessed_lesson_id")
  progressPercentage   Float    @default(0.0) @map("progress_percentage")
  enrolledAt           DateTime @default(now()) @map("enrolled_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
  @@map("enrollments")
}

model QuizAttempt {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  courseSlug          String   @map("course_slug")
  lessonId            String   @map("lesson_id")
  score               Float
  totalQuestions      Int      @map("total_questions")
  correctCount        Int      @map("correct_count")
  answersJson         String   @map("answers_json")
  recommendationsJson String   @map("recommendations_json")
  completedAt         DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model StudyStats {
  userId              String   @id @map("user_id")
  streakDays          Int      @default(1) @map("streak_days")
  lastActiveDate      DateTime @default(now()) @map("last_active_date")
  totalMinutesStudied Int      @default(0) @map("total_minutes_studied")
  lessonsCompleted    Int      @default(0) @map("lessons_completed")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_stats")
}

model AuthoringCourse {
  id               String       @id @default(uuid())
  authorId         String       @map("author_id")
  title            String
  slug             String       @unique
  subjectSlug      String       @map("subject_slug")
  level            String
  status           CourseStatus @default(DRAFT)
  version          Int          @default(1)
  changelog        String?
  priceMinorUnits  Int          @default(0) @map("price_minor_units")
  shortDescription String       @map("short_description")
  fullDescription  String       @map("full_description")
  syllabusJson     String       @map("syllabus_json")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("authoring_courses")
}

model SlotHold {
  id         String   @id @default(uuid())
  tutorSlug  String   @map("tutor_slug")
  studentId  String   @map("student_id")
  slotDate   String   @map("slot_date")
  slotTime   String   @map("slot_time")
  expiresAt  DateTime @map("expires_at")
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("slot_holds")
}

model Booking {
  id                      String        @id @default(uuid())
  studentId               String        @map("student_id")
  tutorSlug               String        @map("tutor_slug")
  tutorName               String        @map("tutor_name")
  subject                 String        @default("Mathematics")
  slotDate                String        @map("slot_date")
  slotTime                String        @map("slot_time")
  amountMinorUnits        Int           @map("amount_minor_units")
  commissionMinorUnits    Int           @map("commission_minor_units")
  tutorEarningsMinorUnits Int           @map("tutor_earnings_minor_units")
  currency                String        @default("NGN")
  bookingStatus           BookingStatus @default(HELD) @map("booking_status")
  paymentStatus           PaymentStatus @default(INITIATED) @map("payment_status")
  paymentReference        String?       @unique @map("payment_reference")
  meetingLink             String?       @map("meeting_link")
  cancellationReason      String?       @map("cancellation_reason")
  rescheduledFromId       String?       @map("rescheduled_from_id")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  student             User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentTransactions PaymentTransaction[]
  ledgerEntries       TutorLedgerEntry[]
  classroomSessions   ClassroomSession[]
  attendances         ClassroomAttendance[]
  tutorReview         TutorReview?
  safeguardingIncidents SafeguardingIncident[]

  @@map("bookings")
}

model PaymentTransaction {
  id               String        @id @default(uuid())
  reference        String        @unique
  bookingId        String        @map("booking_id")
  studentId        String        @map("student_id")
  amountMinorUnits Int           @map("amount_minor_units")
  currency         String        @default("NGN")
  status           PaymentStatus @default(INITIATED)
  channel          String        @default("card")
  paystackResponse String?       @map("paystack_response")
  verifiedAt       DateTime?     @map("verified_at")
  idempotencyKey   String        @unique @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model TutorLedgerEntry {
  id                   String          @id @default(uuid())
  tutorSlug            String          @map("tutor_slug")
  bookingId            String          @map("booking_id")
  transactionReference String          @map("transaction_reference")
  type                 LedgerEntryType
  amountMinorUnits     Int             @map("amount_minor_units")
  currency             String          @default("NGN")
  description          String
  createdAt            DateTime        @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tutor_ledger_entries")
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  subject   String   @default("Mathematics")
  model     String   @default("gemini-1.5-flash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]
  escalations AITutorEscalation[]

  @@map("ai_conversations")
}

model AIMessage {
  id                 String      @id @default(uuid())
  conversationId     String      @map("conversation_id")
  role               AIRole
  content            String
  hintLevel          AIHintLevel @default(HINT_1) @map("hint_level")
  verifiedMathResult String?     @map("verified_math_result")
  tokensUsed         Int         @default(0) @map("tokens_used")
  latencyMs          Int         @default(0) @map("latency_ms")
  isModerated        Boolean     @default(false) @map("is_moderated")
  createdAt          DateTime    @default(now()) @map("created_at")

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedbacks    AIFeedback[]

  @@map("ai_messages")
}

model AIQuota {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  plan             String   @default("FREE")
  queriesUsedToday Int      @default(0) @map("queries_used_today")
  dailyLimit       Int      @default(10) @map("daily_limit")
  lastResetDate    String   @map("last_reset_date")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_quotas")
}

model AIFeedback {
  id        String           @id @default(uuid())
  messageId String           @map("message_id")
  userId    String           @map("user_id")
  rating    AIFeedbackRating
  comment   String?
  createdAt DateTime         @default(now()) @map("created_at")

  message AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_feedbacks")
}

model AITutorEscalation {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  conversationId        String   @map("conversation_id")
  problemStatement      String   @map("problem_statement")
  studentAttemptSummary String?  @map("student_attempt_summary")
  suggestedTutorSlug    String   @default("dr-tayo-okafor") @map("suggested_tutor_slug")
  status                String   @default("PENDING_BOOKING")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_tutor_escalations")
}

// ==============================================================================
// Phase G: Online Virtual Classroom & Safeguarding Engine
// ==============================================================================

enum ClassroomSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum AttendanceStatus {
  ATTENDED
  PARTIAL
  MISSED
}

enum SafeguardingSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SafeguardingCategory {
  INAPPROPRIATE_BEHAVIOR
  HARASSMENT
  TECHNICAL_FAILURE
  SAFETY_CONCERN
  UNAUTHORIZED_RECORDING
}

enum SafeguardingStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model ClassroomSession {
  id                      String                 @id @default(uuid())
  bookingId               String                 @map("booking_id")
  roomName                String                 @unique @map("room_name")
  roomUrl                 String                 @map("room_url")
  status                  ClassroomSessionStatus @default(SCHEDULED)
  recordingEnabled        Boolean                @default(false) @map("recording_enabled")
  startsAt                DateTime               @map("starts_at")
  expiresAt               DateTime               @map("expires_at")
  endedAt                 DateTime?              @map("ended_at")
  lowBandwidthFallbackUsed Boolean               @default(false) @map("low_bandwidth_fallback_used")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  booking      Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attendances  ClassroomAttendance[]
  incidents    SafeguardingIncident[]

  @@map("classroom_sessions")
}

model ClassroomAttendance {
  id              String           @id @default(uuid())
  sessionId       String           @map("session_id")
  bookingId       String           @map("booking_id")
  userId          String           @map("user_id")
  role            String           // STUDENT, TUTOR, GUARDIAN
  joinedAt        DateTime         @default(now()) @map("joined_at")
  leftAt          DateTime?        @map("left_at")
  durationSeconds Int              @default(0) @map("duration_seconds")
  status          AttendanceStatus @default(ATTENDED)
  createdAt       DateTime         @default(now()) @map("created_at")

  session ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  booking Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("classroom_attendances")
}

model SafeguardingIncident {
  id                       String                @id @default(uuid())
  sessionId                String?               @map("session_id")
  bookingId                String?               @map("booking_id")
  reporterId               String                @map("reporter_id")
  reportedUserId           String?               @map("reported_user_id")
  severity                 SafeguardingSeverity  @default(HIGH)
  category                 SafeguardingCategory
  description              String
  sessionTimestampSeconds  Int?                  @map("session_timestamp_seconds")
  status                   SafeguardingStatus    @default(OPEN)
  assignedTo               String?               @map("assigned_to")
  resolutionNotes          String?               @map("resolution_notes")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  session  ClassroomSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  booking  Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reporter User              @relation("ReportedIncidents", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("safeguarding_incidents")
}

model TutorReview {
  id         String   @id @default(uuid())
  bookingId  String   @unique @map("booking_id")
  studentId  String   @map("student_id")
  tutorSlug  String   @map("tutor_slug")
  rating     Int      // 1-5 stars
  reviewText String   @map("review_text")
  isPublic   Boolean  @default(true) @map("is_public")
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("tutor_reviews")
}

// ==============================================================================
// Phase H: Administration, Safeguarding Triage & Financial Operations Models
// ==============================================================================

enum PayoutStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum ReconciliationStatus {
  BALANCED
  FLAGGED_FOR_REVIEW
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  beforeState String? @map("before_state") // JSON string
  afterState  String? @map("after_state")  // JSON string
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
  @@index([adminId])
  @@map("admin_audit_logs")
}

model TutorPayout {
  id                  String       @id @default(uuid())
  tutorSlug           String       @map("tutor_slug")
  tutorUserId         String       @map("tutor_user_id")
  amountMinorUnits    BigInt       @map("amount_minor_units")
  currency            String       @default("NGN")
  bankName            String       @map("bank_name")
  accountNumber       String       @map("account_number")
  accountName         String       @map("account_name")
  status              PayoutStatus @default(PENDING)
  processedByAdminId  String?      @map("processed_by_admin_id")
  notes               String?
  reference           String?      @unique
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  tutor User @relation(fields: [tutorUserId], references: [id], onDelete: Restrict)

  @@index([tutorSlug])
  @@index([status])
  @@map("tutor_payouts")
}

model ReconciliationReport {
  id                     String               @id @default(uuid())
  reportDate             DateTime             @map("report_date")
  provider               String               @default("PAYSTACK")
  totalSettledMinorUnits BigInt               @map("total_settled_minor_units")
  matchedCount           Int                  @default(0) @map("matched_count")
  unmatchedCount         Int                  @default(0) @map("unmatched_count")
  discrepancyMinorUnits  BigInt               @default(0) @map("discrepancy_minor_units")
  status                 ReconciliationStatus @default(BALANCED)
  reconciledBy           String?              @map("reconciled_by")
  notes                  String?
  createdAt              DateTime             @default(now()) @map("created_at")

  @@unique([reportDate, provider])
  @@map("reconciliation_reports")
}

model OperationalAlert {
  id             String        @id @default(uuid())
  type           String
  severity       AlertSeverity @default(INFO)
  title          String
  message        String
  status         AlertStatus   @default(ACTIVE)
  acknowledgedBy String?       @map("acknowledged_by")
  acknowledgedAt DateTime?     @map("acknowledged_at")
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([status, severity])
  @@map("operational_alerts")
}

// ==============================================================================
// Phase I: Multi-Subject Registry, Dynamic Curriculum & AI Subject Governance
// Requirements: SB-01 through SB-09, ADR-010
// ==============================================================================

enum SubjectStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum SubjectDeliveryFormat {
  ONE_ON_ONE_ONLINE
  SELF_PACED_ACADEMY
  HYBRID
}

enum SubjectAIEvalStatus {
  NOT_STARTED
  IN_EVALUATION
  PASSED
  FAILED
}

model Subject {
  id                    String                @id @default(uuid())
  slug                  String                @unique
  name                  String
  description           String
  category              String                @default("General")
  levels                String[]              @default(["JSS 1-3", "SSS 1-3", "WAEC/JAMB"])
  deliveryFormats       String[]              @default(["ONE_ON_ONE_ONLINE", "SELF_PACED_ACADEMY"]) @map("delivery_formats")
  status                SubjectStatus         @default(DRAFT)
  icon                  String                @default("BookOpen")
  color                 String                @default("purple")
  pricingTierMinorUnits Int                   @default(500000) @map("pricing_tier_minor_units")
  commissionRatePercent Float                 @default(15.00) @map("commission_rate_percent")
  aiEnabled             Boolean               @default(false) @map("ai_enabled")
  aiEvaluationStatus    SubjectAIEvalStatus   @default(NOT_STARTED) @map("ai_evaluation_status")
  aiEvaluationScore     Float?                @map("ai_evaluation_score")
  aiEvaluationSignedBy  String?               @map("ai_evaluation_signed_by")
  aiEvaluationSignedAt  DateTime?             @map("ai_evaluation_signed_at")
  aiGroundingSummary    String?               @map("ai_grounding_summary")
  aiVerificationMethod  String                @default("SYMBOLIC_SOLVER") @map("ai_verification_method")
  aiSystemPrompt        String?               @map("ai_system_prompt")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  evaluations           SubjectAIEvaluation[]
  tutorQualifications   TutorSubjectQualification[]
  contentAssignments    ContentManagerSubjectAssignment[]

  @@index([status])
  @@index([category])
  @@map("subjects")
}

model SubjectAIEvaluation {
  id                        String   @id @default(uuid())
  subjectSlug               String   @map("subject_slug")
  evaluatorId               String   @map("evaluator_id")
  rubricScore               Float    @map("rubric_score")
  passed                    Boolean  @default(false)
  unsafeContentBlockedCount Int      @default(0) @map("unsafe_content_blocked_count")
  groundingCoveragePercent  Float    @default(0.0) @map("grounding_coverage_percent")
  notes                     String?
  signOffSignature          String   @map("sign_off_signature")
  evaluatedAt               DateTime @default(now()) @map("evaluated_at")

  subject   Subject @relation(fields: [subjectSlug], references: [slug], onDelete: Cascade)
  evaluator User    @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@index([subjectSlug])
  @@map("subject_ai_evaluations")
}

model TutorSubjectQualification {
  id                    String    @id @default(uuid())
  tutorSlug             String    @map("tutor_slug")
  subjectSlug           String    @map("subject_slug")
  levels                String[]  @default(["JSS 1-3", "SSS 1-3"])
  credentialEvidenceUrl String    @map("credential_evidence_url")
  credentialType        String    @default("UNIVERSITY_DEGREE") @map("credential_type")
  status                String    @default("PENDING")
  verifiedByAdminId     String?   @map("verified_by_admin_id")
  verifiedAt            DateTime? @map("verified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  subject  Subject @relation(fields: [subjectSlug], references: [slug], onDelete: Cascade)
  verifier User?   @relation("VerifiedQualifications", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  @@unique([tutorSlug, subjectSlug])
  @@index([subjectSlug, status])
  @@map("tutor_subject_qualifications")
}

model ContentManagerSubjectAssignment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  subjectSlug String   @map("subject_slug")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectSlug], references: [slug], onDelete: Cascade)

  @@unique([userId, subjectSlug])
  @@map("content_manager_subject_assignments")
}


