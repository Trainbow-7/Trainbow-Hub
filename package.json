{
  "name": "trainbow-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/phase0-smoke.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "verify:live-ai": "tsx scripts/verify-live-ai.ts",
    "tools:test": "tsx scripts/test-tools.ts",
    "eval:solver": "tsx scripts/eval-solver.ts",
    "ingest:docs": "tsx scripts/ingest-docs.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "prisma": "^5.21.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.453.0",
    "mathjs": "^15.2.0",
    "nerdamer": "^2.0.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.48.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
